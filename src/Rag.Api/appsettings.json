{
  "AllowedHosts": "*",
  "Authentication": {
    "ApiKey": {
      "Clients": [],
      "HeaderName": "X-API-Key",
      "Pepper": ""
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "ConnectionString": ""
  },
  "Chunking": {
    "MaxTokens": 500,
    "OverlapTokens": 80
  },
  "Embedding": {
    "BatchSize": 32,
    "Dimensions": 1536,
    "MaxConcurrency": 2,
    "Model": "",
    "Provider": "",
    "RequestTimeoutSeconds": 30
  },
  "Generation": {
    "FallbackMode": "EvidenceOnly",
    "MaxContextTokens": 4000,
    "MaxHistoryCharacters": 8000,
    "MaxHistoryMessages": 6,
    "MaxOutputTokens": 800,
    "MinimumEvidenceCount": 1,
    "MinimumEvidenceScore": 0.0,
    "Model": "",
    "Provider": "",
    "RequestTimeoutSeconds": 30
  },
  "Jobs": {
    "BaseRetryDelaySeconds": 5,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 5,
    "MaxRetryDelaySeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Rag.Api"
  },
  "RateLimiting": {
    "ChatbotPermitLimit": 50,
    "TenantPermitLimit": 100,
    "WindowSeconds": 60
  },
  "Retrieval": {
    "FinalTopK": 8,
    "LexicalTopK": 20,
    "MaxQueryLength": 2000,
    "MaxResultsPerDocument": 2,
    "MinimumScore": 0.0,
    "ReciprocalRankConstant": 60,
    "TextSearchConfiguration": "simple",
    "VectorTopK": 20
  },
  "Storage": {
    "LocalPath": "",
    "Provider": ""
  },
  "Uploads": {
    "IdempotencyTtlHours": 24,
    "MaxFileSizeBytes": 10485760
  }
}
