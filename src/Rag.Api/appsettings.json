{
  "AllowedHosts": "*",
  "Authentication": {
    "ApiKey": {
      "Clients": [],
      "HeaderName": "X-API-Key",
      "Pepper": ""
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "ConnectionString": ""
  },
  "Embedding": {
    "Dimensions": 1536,
    "Model": ""
  },
  "Jobs": {
    "BaseRetryDelaySeconds": 5,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 5,
    "MaxRetryDelaySeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Rag.Api"
  },
  "RateLimiting": {
    "ChatbotPermitLimit": 50,
    "TenantPermitLimit": 100,
    "WindowSeconds": 60
  },
  "Storage": {
    "LocalPath": "",
    "Provider": ""
  },
  "Uploads": {
    "IdempotencyTtlHours": 24,
    "MaxFileSizeBytes": 10485760
  }
}
